set_property IOSTANDARD DIFF_SSTL12_DCI [get_ports {C0_DDR4_ck_c[*] C0_DDR4_ck_t[*]}]
set_property IOSTANDARD POD12_DCI [get_ports {C0_DDR4_dm_n[*] C0_DDR4_dq[*]}]
