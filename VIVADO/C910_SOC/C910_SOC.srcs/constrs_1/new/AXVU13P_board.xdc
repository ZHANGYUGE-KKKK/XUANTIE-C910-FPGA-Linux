## AXVU13P 开发板引脚约束
## 引脚来源：AXVU13P_UG.pdf

## DDR4 同 SLR 200MHz 差分参考时钟，原理图第 3 页
## 原理图网络名为 C1_DDR4_CLKREF_P=AF32、C1_DDR4_CLKREF_N=AF33，位于 FPGA_BANK63
set_property -dict {PACKAGE_PIN AF32 IOSTANDARD LVDS} [get_ports BADJ_CLK_clk_p]
set_property -dict {PACKAGE_PIN AF33 IOSTANDARD LVDS} [get_ports BADJ_CLK_clk_n]
create_clock -period 5.000 -name C1_DDR4_CLKREF_200M [get_ports BADJ_CLK_clk_p]

## DDR4 SODIMM，数据位宽 64bit，使用 PL_DDR4_DQ[0:63] / DQS[0:7] / DM[0:7]
## AXVU13P datasheet 第 9-13 页；DDR4 A14/A15/A16 分别复用 WE_B/CAS_B/RAS_B
